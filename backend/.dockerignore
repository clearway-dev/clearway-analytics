# Version control
.git
.gitignore

# Documentation
README.md
*.md

# Environment files — never bake secrets into the image
.env
.env.*

# Python cache
__pycache__
*.pyc
*.pyo
*.pyd

# Dev/test artifacts
tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Maintenance scripts — not needed for the running API
scripts/
calculate_stats.py

# Docker files themselves
Dockerfile
.dockerignore
